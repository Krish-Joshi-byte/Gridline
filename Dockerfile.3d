FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GRIDLINE_DATA_DIR=/data

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-3d.txt .
RUN pip install --no-cache-dir -r requirements-3d.txt

COPY gridline_reconstruction_api.py .
RUN mkdir -p /data/uploads /data/results

EXPOSE 8000
CMD ["uvicorn", "gridline_reconstruction_api:app", "--host", "0.0.0.0", "--port", "8000"]
