# Copy this to .env.production and fill in real values once you have them.
# Leave everything unset for local dev — the app falls back to free,
# no-key defaults (CARTO tiles + OSRM routing) automatically.

# Backend URL once it's hosted somewhere (Render, Railway, a VPS, etc).
VITE_API_BASE=https://api.gridline.wiki

# Optional — Mapbox access token for nicer map tiles. Get one free at
# https://account.mapbox.com/access-tokens/ (50k free map loads/month,
# no card required to start). Leave unset to keep using the free CARTO
# dark tiles instead.
VITE_MAPBOX_TOKEN=

# Optional — OpenRouteService API key, used as an automatic fallback if
# OSRM's public routing server is ever down or rate-limited. Get a free
# key at https://openrouteservice.org/dev/#/signup (~2,000 requests/day
# on the free tier). Leave unset to skip the fallback and rely on OSRM only.
VITE_ORS_API_KEY=
